# FrameClash settings (read by frameclash.service). Restart after editing:
#   systemctl --user restart frameclash
# Web UI address. Loopback only in the MVP (frameclashd refuses anything else).
FRAMECLASH_UI_ADDR=127.0.0.1:7899
# mihomo mixed (HTTP + SOCKS5) proxy port, bound to 127.0.0.1
FRAMECLASH_MIXED_PORT=7890
# mihomo external-controller port, bound to 127.0.0.1 (secret in ~/.config/frameclash/secret)
FRAMECLASH_CONTROLLER_PORT=9090
# The VR panel's Paste button reads the X clipboard itself (libxcb): $DISPLAY, else every /tmp/.X11-unix/XN
# (gamescope's Xwayland :0 on the Frame). Set it here only if Paste finds no clipboard
# (then: systemctl --user restart frameclash-panel).
#DISPLAY=:0
